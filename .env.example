# Neon PostgreSQL Database Connection
# In Neon Console: Create project 'concrete-stock-count' and copy the connection string
DATABASE_URL=postgresql://user:password@ep-sample-pool-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Better Auth Configuration
# Generate a 32-character random string (e.g., openssl rand -base64 32)
BETTER_AUTH_SECRET=your_32_character_secret_key_here

# App URL (Localhost in dev, Vercel Production domain in prod)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
